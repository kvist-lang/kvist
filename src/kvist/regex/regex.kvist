(package regex)
(import rx "core:text/regex")

;; Pattern text accepted by regex.compile and regex.matches?.
(def Pattern string)
;; Compiled Odin regular expression; release it with regex.destroy!.
(def Regex rx.Regular_Expression)
;; Captured match storage; release it with regex.destroy-capture!.
(def Capture rx.Capture)
;; Error returned while compiling or matching a regular expression.
(def Error rx.Error)
;; Odin regular-expression option flags accepted by compile-with-flags.
(def Flags rx.Flags)

(defn compile
  "Compile `pattern` with Odin's default regex flags.

  The returned regex owns compiler-allocated storage. A non-escaping
  destructured result is cleaned automatically; otherwise destroy a successful
  result with `regex.destroy!`."
  [pattern: Pattern] -> [value: Regex, err: Error] #force_inline
  (rx.create pattern))

(defn compile-with-flags
  "Compile `pattern` with explicit Odin regex flags.

  The returned regex owns compiler-allocated storage. A non-escaping
  destructured result is cleaned automatically; otherwise destroy a successful
  result with `regex.destroy!`."
  [pattern: Pattern, flags: Flags] -> [value: Regex, err: Error] #force_inline
  (rx.create pattern flags))

(defn destroy!
  "Destroy a compiled regex returned by `regex.compile` or Odin `rx.create`."
  [value: Regex] #force_inline
  (rx.destroy value))

(defn match
  "Match a compiled regex against `s` and return allocated capture data.

  Capture strings are slices into `s`, but the capture arrays are owned. A
  non-escaping destructured result is cleaned automatically; otherwise destroy
  the capture result with `regex.destroy-capture!`."
  [compiled: Regex, s: string] -> [capture: Capture, ok: bool] #force_inline
  (rx.match_and_allocate_capture compiled s))

(defn destroy-capture!
  "Destroy capture arrays returned by `regex.match`."
  [capture: Capture] #force_inline
  (rx.destroy capture))

(defn matches-compiled?
  "Return true when compiled regex `compiled` matches `s`.

  This allocates temporary capture arrays and destroys them before returning."
  [compiled: Regex, s: string] -> bool #force_inline
  (let [[capture ok] (rx.match_and_allocate_capture compiled s)]
    ok))

(defn matches?
  "Compile `pattern`, match it against `s`, destroy intermediate data, and return success."
  [pattern: Pattern, s: string] -> bool #force_inline
  (let [[compiled err] (rx.create pattern)]
    (if (!= err nil)
      false
      (matches-compiled? compiled s))))

(defn find?
  "Alias for `regex.matches?`; Odin regex matching searches according to the pattern."
  [pattern: Pattern, s: string] -> bool #force_inline
  (matches? pattern s))
