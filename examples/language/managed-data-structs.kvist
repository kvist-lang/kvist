(package main)

(import data "kvist:data")

(defstruct Person [
  name: Data
])

(defn make-person [name: Data] -> Person
  (Person :name name))

(defn print-person [person: Person]
  (println (data.string person.name)))

(defn main []
  (let [name (data.from-string "Ada")
        person (Person :name (data.retain name))
        copy person]
    (print-person (make-person (data.retain name)))
    (discard (make-person (data.retain name)))
    (println (data.string copy.name))))
