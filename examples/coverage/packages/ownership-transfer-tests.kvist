(package tests)

(import strings "core:strings")
(import data "kvist:data")
(import t "kvist:test")

(defstruct Owned-Value [value: string])
(defstruct Link [observed: Owned-Value])
(defstruct Envelope [link: Link])
(defstruct Owned-Pair [left: string right: string marker: int])
(defstruct Direct-Inner [text: string])
(defstruct Direct-Outer [inner: Direct-Inner marker: int])
(defstruct Data-Snapshot [comments: Data])
(defunion Owned-Choice [owned: Owned-Value number: int])
(defunion Text-Choice [text: string values: [dynamic]int number: int])

(defn- clone-text [value: string] -> string
  (let [[result error] (strings.clone value)]
    (assert (= error nil))
    result))

(defn- clone-text-result [value: string] -> [result: string, ok: bool]
  (assert (> (count value) 0))
  (let [[cloned error] (strings.clone value)]
    (assert (= error nil))
    (return cloned true)))

(defn- clone-text-result-through-alias
  [value: string] -> [result: string, ok: bool]
  (let [[cloned error] (strings.clone value)]
    (assert (= error nil))
    (let [aliased cloned]
      (return aliased true))))

(defn- clone-text-direct-result [value: string]
  -> [result: string, ok: bool]
  (do
    (assert (> (count value) 0))
    (return (strings.clone value) true)))

(defn- clone-text-single-binding-result [value: string]
  -> [result: string, ok: bool]
  (let [cloned (strings.clone value)]
    (return cloned true)))

(defn- clone-text-pair-results [left: string right: string]
  -> [left-result: string, right-result: string]
  (return (strings.clone left) (strings.clone right)))

(defn- replace-text-result [value: string old: string new: string]
  -> [allocated?: bool, result: string]
  (let [[replaced did-allocate?] (strings.replace value old new -1)]
    (return did-allocate? replaced)))

(defn- maybe-borrow-replaced-text [value: string borrow?: bool]
  -> [allocated?: bool, result: string]
  (let [[replaced did-allocate?] (strings.replace value "e" "a" -1)]
    (when borrow?
      (return true value))
    (return did-allocate? replaced)))

(defn- replace-text-with-inverted-condition [value: string]
  -> [allocated?: bool, result: string]
  (let [[replaced did-allocate?] (strings.replace value "z" "x" -1)]
    (set! did-allocate? (not did-allocate?))
    (return did-allocate? replaced)))

(defn- replace-text-with-toggled-condition [value: string]
  -> [allocated?: bool, result: string]
  (let [[replaced did-allocate?] (strings.replace value "z" "x" -1)]
    (toggle! did-allocate?)
    (return did-allocate? replaced)))

(defn- clone-owned [value: string] -> Owned-Value
  (let [[result error] (strings.clone value)]
    (assert (= error nil))
    (Owned-Value :value result)))

(defn- delete-links [links: [dynamic]Link]
  (for [link links]
    (delete link.observed.value))
  (delete links))

(defn- delete-envelopes [envelopes: [dynamic]Envelope]
  (for [envelope envelopes]
    (delete envelope.link.observed.value))
  (delete envelopes))

(defn- delete-pairs [pairs: [dynamic]Owned-Pair]
  (for [pair pairs]
    (delete pair.left)
    (delete pair.right))
  (delete pairs))

(defn- make-pair [marker: int] -> Owned-Pair
  (Owned-Pair
    :left (clone-text "left")
    :right (clone-text "right")
    :marker marker))

(defn- delete-pair [pair: Owned-Pair]
  (delete pair.left)
  (delete pair.right))

(defn- delete-choice [choice: Owned-Choice]
  (case choice
    (Owned-Value value) (delete value.value)
    (int _) (discard 0)
    (discard 0)))

(defn- delete-text-choice [choice: Text-Choice]
  (case choice
    (string value) (delete value)
    ([dynamic]int values) (delete values)
    (int _) (discard 0)
    (discard 0)))

(defn- delete-direct-outers [values: [dynamic]Direct-Outer]
  (for [value values]
    (delete value.inner.text))
  (delete values))

(defn- make-direct-outer [] -> Direct-Outer
  (Direct-Outer
    :inner (Direct-Inner :text (clone-text "nested-return"))
    :marker 5))

(defn- consume-direct-outer [value: Direct-Outer]
  (delete value.inner.text))

(defn- delete-text [value: string]
  (delete value))

(defn- pull-comments [ok?: bool] -> [comments: Data, ok: bool]
  (return [{:id "comment-1"} {:id "comment-2"}] ok?))

(defn- load-comments [ok?: bool] -> Data-Snapshot
  (let [[comments ok] (pull-comments ok?)]
    (when (not ok)
      (data.release comments)
      (return (Data-Snapshot :comments nil)))
    (Data-Snapshot :comments comments)))

(defn- extract-direct-text [] -> string
  (let [outer (Direct-Outer
                :inner (Direct-Inner :text (clone-text "field-return"))
                :marker 6)]
    outer.inner.text))

(defn- extract-branch-text [left?: bool] -> string
  (let [left (make-direct-outer)
        right (Direct-Outer
                :inner (Direct-Inner :text (clone-text "right"))
                :marker 7)]
    (if left? left.inner.text right.inner.text)))

(defn- take-pair-left [pair: Owned-Pair] -> string
  (delete pair.right)
  pair.left)

(defn- take-direct-text [outer: Direct-Outer] -> string
  outer.inner.text)

(defn- take-pair-left-through-alias [pair: Owned-Pair] -> string
  (let [result pair.left]
    (delete pair.right)
    result))

(defn- take-pair-branch [pair: Owned-Pair left?: bool] -> string
  (if left?
    (do
      (delete pair.right)
      pair.left)
    (do
      (delete pair.left)
      pair.right)))

(t.deftest named-owned-field-moves-through-struct-into-array
  (let [owned (clone-owned "named")
        link (Link :observed owned)
        links (make [dynamic]Link) :defer-with delete-links]
    (append (addr links) link)
    (t.is (= links[0].observed.value "named"))))

(t.deftest owned-native-multi-result-propagates-through-local-let-wrapper
  (let [[value ok] (clone-text-result "wrapped")
        [aliased alias-ok] (clone-text-result-through-alias "aliased")
        [direct direct-ok] (clone-text-direct-result "direct")
        [single single-ok] (clone-text-single-binding-result "single")]
    (t.is ok)
    (t.is alias-ok)
    (t.is direct-ok)
    (t.is single-ok)
    (t.is (= value "wrapped"))
    (t.is (= aliased "aliased"))
    (t.is (= direct "direct"))
    (t.is (= single "single"))))

(t.deftest conditional-owned-result-remaps-its-sibling-after-reordering
  (let [[unchanged? unchanged] (replace-text-result "hello" "z" "x")
        [changed? changed] (replace-text-result "hello" "e" "a")]
    (t.is (not unchanged?))
    (t.is (= unchanged "hello"))
    (t.is changed?)
    (t.is (= changed "hallo"))))

(t.deftest conditional-owned-tail-does-not-hide-an-early-borrowed-return
  (let [[marked-owned? value] (maybe-borrow-replaced-text "hello" true)]
    (t.is marked-owned?)
    (t.is (= value "hello"))))

(t.deftest conditional-owned-result-rejects-a-mutated-sibling
  (let [[marked-owned? value] (replace-text-with-inverted-condition "hello")]
    (t.is marked-owned?)
    (t.is (= value "hello"))))

(t.deftest conditional-owned-result-rejects-a-toggled-sibling
  (let [[marked-owned? value] (replace-text-with-toggled-condition "hello")]
    (t.is marked-owned?)
    (t.is (= value "hello"))))

(t.deftest discarded-owned-results-are-cleaned-immediately
  (discard (strings.clone "expression-discard"))
  (discard (clone-text-pair-results "discard-left" "discard-right"))
  (discard (strings.replace "hello" "e" "a" -1))
  (let [_ (strings.clone "simple-discard")
        [_ right] (clone-text-pair-results "left" "right")
        [_ unchanged-allocated?] (strings.replace "hello" "z" "x" -1)
        [_ changed-allocated?] (strings.replace "hello" "e" "a" -1)
        [_ _] (strings.replace "hello" "e" "a" -1)
        [_ comments-ok] (pull-comments true)]
    (t.is (= right "right"))
    (t.is (not unchanged-allocated?))
    (t.is changed-allocated?)
    (t.is comments-ok)))

(t.deftest owned-managed-multi-result-moves-into-returned-struct
  (let [snapshot (load-comments true)
        empty (load-comments false)]
    (t.is (= (data.count snapshot.comments) 2))
    (t.is (data.nil? empty.comments))))

(t.deftest positional-owned-field-moves-through-two-structs-into-array
  (let [owned (clone-owned "positional")
        link (Link owned)
        envelope (Envelope link)
        envelopes (make [dynamic]Envelope) :defer-with delete-envelopes]
    (append (addr envelopes) envelope)
    (t.is (= envelopes[0].link.observed.value "positional"))))

(t.deftest multiple-owned-fields-move-together
  (let [left (clone-owned "left")
        right (clone-owned "right")
        pair (Owned-Pair :left left.value :right right.value :marker 7)
        pairs (make [dynamic]Owned-Pair) :defer-with delete-pairs]
    (append (addr pairs) pair)
    (t.is (= pairs[0].left "left"))
    (t.is (= pairs[0].right "right"))))

(t.deftest conditional-owned-aggregate-storage-moves-on-both-paths
  (let [left (clone-owned "branch-left")
        right (clone-owned "branch-right")
        pair (Owned-Pair left.value right.value 1)
        pairs (make [dynamic]Owned-Pair) :defer-with delete-pairs]
    (if (= pair.marker 1)
      (append (addr pairs) pair)
      (append (addr pairs) pair))
    (t.is (= (count pairs) 1))))

(t.deftest loop-owned-aggregate-storage-moves-each-iteration
  (let [pairs (make [dynamic]Owned-Pair) :defer-with delete-pairs]
    (for [index ([3]int [0 1 2])]
      (let [left (clone-owned "loop-left")
            right (clone-owned "loop-right")
            pair (Owned-Pair left.value right.value index)]
        (append (addr pairs) pair)))
    (t.is (= (count pairs) 3))
    (t.is (= pairs[2].marker 2))))

(t.deftest conditional-owned-procedure-result-is-cleaned
  (let [pair (if true (make-pair 1) (make-pair 2))]
    (t.is (= pair.marker 1))))

(t.deftest conditional-owned-result-alias-has-one-cleanup
  (let [pair (if false (make-pair 1) (make-pair 2))
        moved pair :defer-with delete-pair]
    (t.is (= moved.marker 2))))

(t.deftest named-owned-struct-payload-moves-into-union
  (let [owned (clone-owned "union-named")
        choice (Owned-Choice :owned owned) :defer-with delete-choice]
    (t.is (= (case choice (Owned-Value value) value.value "") "union-named"))))

(t.deftest positional-owned-struct-payload-moves-into-union
  (let [owned (clone-owned "union-positional")
        choice (Owned-Choice owned) :defer-with delete-choice]
    (t.is (= (case choice (Owned-Value value) value.value "") "union-positional"))))

(t.deftest direct-owned-call-in-struct-field-is-cleaned
  (let [owned (Owned-Value :value (clone-text "direct"))]
    (t.is (= owned.value "direct"))))

(t.deftest positional-owned-string-payload-moves-into-union
  (let [text (clone-text "union-string")
        choice (Text-Choice text) :defer-with delete-text-choice]
    (t.is (= (case choice (string value) value "") "union-string"))))

(t.deftest direct-nested-owned-field-is-cleaned
  (let [outer (Direct-Outer
                :inner (Direct-Inner :text (clone-text "direct-nested"))
                :marker 3)]
    (t.is (= outer.inner.text "direct-nested"))))

(t.deftest direct-nested-owned-field-moves-to-array
  (let [outer (Direct-Outer
                :inner (Direct-Inner :text (clone-text "nested-array"))
                :marker 4)
        values (make [dynamic]Direct-Outer) :defer-with delete-direct-outers]
    (append (addr values) outer)
    (t.is (= values[0].inner.text "nested-array"))))

(t.deftest returned-direct-nested-owned-field-is-cleaned
  (let [outer (make-direct-outer)]
    (t.is (= outer.inner.text "nested-return"))))

(t.deftest nested-owned-field-transfers-to-consuming-parameter
  (let [outer (make-direct-outer)]
    (consume-direct-outer outer)
    (t.is true)))

(t.deftest deleted-owned-field-can-be-reassigned
  (let [owned (Owned-Value :value (clone-text "old"))]
    (delete owned.value)
    (set! owned.value (clone-text "new"))
    (t.is (= owned.value "new"))))

(t.deftest conditionally-reassigned-owned-field-restores-owner-flag
  (for [replace? ([2]bool [false true])]
    (let [owned (Owned-Value :value (clone-text "old"))]
      (delete owned.value)
      (if replace?
        (set! owned.value (clone-text "new"))
        (discard 0))
      (t.is true))))

(t.deftest nested-owned-field-return-is-cleaned-by-caller
  (let [value (extract-direct-text)]
    (t.is (= value "field-return"))))

(t.deftest branch-field-return-cleans-unselected-owner
  (for [left? ([2]bool [false true])]
    (let [value (extract-branch-text left?)]
      (t.is (> (count value) 0)))))

(t.deftest explicitly-cleaned-field-alias-moves-owner
  (let [outer (make-direct-outer)
        value outer.inner.text :defer-with delete-text]
    (t.is (= value "nested-return"))))

(t.deftest owned-parameter-field-return-moves-owner
  (let [pair (make-pair 8)
        value (take-pair-left pair) :defer-with delete-text]
    (t.is (= value "left"))))

(t.deftest nested-owned-parameter-field-return-moves-owner
  (let [outer (make-direct-outer)
        value (take-direct-text outer) :defer-with delete-text]
    (t.is (= value "nested-return"))))

(t.deftest owned-parameter-field-alias-return-moves-owner
  (let [pair (make-pair 9)
        value (take-pair-left-through-alias pair) :defer-with delete-text]
    (t.is (= value "left"))))

(t.deftest owned-parameter-branch-field-return-moves-owner
  (for [left? ([2]bool [false true])]
    (let [pair (make-pair 10)
          value (take-pair-branch pair left?) :defer-with delete-text]
      (t.is (> (count value) 0)))))
