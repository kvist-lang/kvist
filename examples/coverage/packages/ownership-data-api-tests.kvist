(t.deftest dynamic-data-search-results-balance-references
 (let [value (data.from-string "owned") items: Data [value value]
       [left right] (data.split-at 1 items)
       [found found?] (data.find owned? items)
       [index indexed indexed?] (data.find-indexed indexed-owned? items)
       [minimum min?] (data.min-by native-key items)
       [maximum max?] (data.max-by native-key items)
       [looked-up present?] (data.lookup {:key value} :key)]
  (t.is (and found? indexed? min? max? present?))
  (t.is (= index 0))
  (t.is (data.equal? left right))
  (t.is (data.equal? found indexed))
  (t.is (data.equal? minimum maximum))
  (t.is (data.equal? value looked-up))))
(t.deftest captured-data-callback-results-balance-references
 (let [capture (data.from-string "owned") items: Data [capture capture]
       mapped (data.map (fn [item: Data] -> Data capture) items)
       reduced (data.reduce (fn [acc: Data item: Data] -> Data capture) capture items)]
  (t.is (data.equal? mapped '["owned" "owned"]))
  (t.is (data.equal? reduced capture))))
(defstruct Decoded [value: Data])
(t.deftest data-decode-success-and-failure-balance-references
 (let [value (data.from-string "owned") source: Data {:value value}
       [decoded error ok] (data.decode Decoded source)
       [failed failure bad-ok] (data.decode Decoded [value])]
  (t.is ok) (t.is (not bad-ok))
  (t.is (data.equal? decoded.value value))))
