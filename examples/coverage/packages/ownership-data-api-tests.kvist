(package tests)
(import data "kvist:data")
(import t "kvist:test")
(defn identity-value [value: Data] -> Data value)
(defn clone-value [value: Data] -> Data (data.from-string (data.string value)))
(defn owned? [value: Data] -> bool (= (data.string value) "owned"))
(defn indexed-owned? [index: int value: Data] -> bool (owned? value))
(defn indexed-identity [index: int value: Data] -> Data value)
(defn entry [key: Data value: Data] -> Data [key value])
(defn entry-owned? [key: Data value: Data] -> bool (owned? value))
(defn combine [left: Data right: Data] -> Data left)
(defn native-key [value: Data] -> string (data.string value))
(defn before? [left: Data right: Data] -> bool (< (data.string left) (data.string right)))
(defn constant-key [value: Data] -> Data (data.from-string "same"))

(t.deftest dynamic-data-keys-balances-references
 (let [value (data.from-string "owned") other (data.from-string "other")
       items: Data [value other value] mapping: Data {:a value :b other}
       nested: Data {:inner mapping} path: Data [:inner :a]
       result (data.keys mapping)]
  (t.is (data.equal? result '[:a :b]))))

(t.deftest dynamic-data-vals-balances-references
 (let [value (data.from-string "owned") other (data.from-string "other")
       items: Data [value other value] mapping: Data {:a value :b other}
       nested: Data {:inner mapping} path: Data [:inner :a]
       result (data.vals mapping)]
  (t.is (data.equal? result '["owned" "other"]))))

(t.deftest dynamic-data-entries-balances-references
