;; Struct mutation and set-valued field coverage.
(package main)
(import core "kvist:core")
(import set "kvist:set")

(defstruct Person
  "A small fixed-shape person struct."
  [name: string
   age: int
   tags: (map string (struct []))])

(defn records-demo [] -> bool
  (let [tags (set.empty string 2) :defer
        person (Person :name "Ada"
                        :age 36
                        :tags tags)]
    (set.add! tags "math")
    (set.add! tags "lisp")
    (println person.name)
    (println person.age)
    (println person.tags)
    (println (set.contains? person.tags "math"))
    (set! person.age 37)
    (println person)
    true))

(defn main []
  (println (records-demo)))

(comment
  ;; Sets are ordinary map[T]struct{} values in Kvist.
  (records-demo))
